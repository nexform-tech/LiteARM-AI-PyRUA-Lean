  <joint name="gripper_slide_joint_left" type="prismatic">
    <origin xyz="0.067 -0.0010833 0.034083" rpy="0 0 0" />
    <parent link="gripper_base" />
    <child link="gripper_slider_link2" />
    <axis xyz="-1 0 0" />
    <limit lower="0" upper="0.0425" effort="10" velocity="0.2" />
    <!-- Real LiteGrip: one motor drives both fingers through a rack.  The axes
         above are opposite, so equal joint positions already mirror the motion;
         multiplier=+1 (no inversion).  The importer writes the PhysX equivalent
         (additive form, gearing=-1). -->
    <mimic joint="gripper_slide_joint_right" multiplier="1" offset="0" />
  </joint>
